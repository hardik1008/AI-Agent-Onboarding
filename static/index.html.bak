<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>PolicyNest | Enterprise AI-First POSP Onboarding Suite (Production v3.2)</title>
  
  <!-- Fonts & Libraries -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            brand: {
              50: '#eef2ff',
              100: '#e0e7ff',
              200: '#c7d2fe',
              500: '#4f46e5',
              600: '#4338ca',
              700: '#3730a3',
              900: '#1e1b4b',
            },
            emerald: {
              400: '#34d399',
              500: '#10b981',
              600: '#059669',
              700: '#047857',
            }
          }
        }
      }
    }
  </script>

  <style>
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: #f8fafc; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    
    .glass-surface {
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(226, 232, 240, 0.9);
      box-shadow: 0 10px 30px -10px rgba(15, 23, 42, 0.06);
    }
    
    .laser-scan-anim {
      position: absolute;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, #4f46e5, #06b6d4, transparent);
      box-shadow: 0 0 14px #4f46e5;
      animation: laserScan 2.2s ease-in-out infinite alternate;
    }

    @keyframes laserScan {
      0% { top: 4%; opacity: 0.7; }
      50% { opacity: 1; }
      100% { top: 96%; opacity: 0.7; }
    }

    .modal-backdrop {
      background: rgba(15, 23, 42, 0.7);
      backdrop-filter: blur(8px);
    }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 antialiased min-h-screen flex flex-col font-sans selection:bg-brand-500 selection:text-white">

  <!-- ================= TOP COMMERCIAL NAVBAR ================= -->
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200/90 shadow-sm">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      
      <!-- Brand & IRDAI Regulator Trust -->
      <div class="flex items-center space-x-3.5">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 via-indigo-600 to-cyan-500 flex items-center justify-center text-white shadow-md shadow-brand-500/20 flex-shrink-0">
          <i data-lucide="shield-check" class="w-6 h-6"></i>
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <span class="text-xl font-extrabold tracking-tight text-slate-900">Policy<span class="text-brand-600">Nest</span></span>
            <span class="text-[10px] font-bold bg-emerald-50 text-emerald-700 px-2.5 py-0.5 rounded-full border border-emerald-200/80 flex items-center space-x-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>IRDAI Reg #842</span>
            </span>
          </div>
          <p class="text-[11px] text-slate-500 font-medium -mt-0.5">InsuranceDekho Enterprise POSP Network</p>
        </div>
      </div>

      <!-- 4 Core Enterprise Perspectives -->
      <div class="hidden lg:flex items-center bg-slate-100/90 p-1 rounded-xl border border-slate-200">
        <button id="nav-btn-applicant" onclick="switchPortal('applicant')" class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all bg-white text-brand-600 shadow-sm flex items-center space-x-1.5">
          <i data-lucide="user-check" class="w-3.5 h-3.5"></i>
          <span>1. Applicant Portal</span>
        </button>
        <button id="nav-btn-ops" onclick="switchPortal('ops')" class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all text-slate-600 hover:text-slate-900 flex items-center space-x-1.5">
          <i data-lucide="cpu" class="w-3.5 h-3.5"></i>
          <span>2. Reviewer Cockpit (22 Ops)</span>
          <span class="text-[10px] bg-indigo-100 text-indigo-700 font-bold px-1.5 py-0.2 rounded" id="nav-db-count">600 DB</span>
        </button>
        <button id="nav-btn-lms" onclick="switchPortal('lms')" class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all text-slate-600 hover:text-slate-900 flex items-center space-x-1.5">
          <i data-lucide="graduation-cap" class="w-3.5 h-3.5"></i>
          <span>3. 15-Hour LMS Course</span>
        </button>
        <button id="nav-btn-ai" onclick="switchPortal('ai')" class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all text-indigo-700 bg-indigo-50 hover:bg-indigo-100 flex items-center space-x-1.5 border border-indigo-200/60 ml-1">
          <i data-lucide="brain-circuit" class="w-3.5 h-3.5 text-brand-600"></i>
          <span>4. AI Observatory & Retraining</span>
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
        </button>
      </div>

      <!-- Actions: Quick Demo Fill & WhatsApp -->
      <div class="flex items-center space-x-2.5">
        <button onclick="autoFillRealDemoUser()" class="px-3 py-1.5 bg-brand-50 hover:bg-brand-100 text-brand-700 text-xs font-bold rounded-lg border border-brand-200 transition flex items-center space-x-1.5" title="Auto-populate sample applicant details">
          <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
          <span>Quick Demo Fill</span>
        </button>

        <button onclick="togglePhoneHUD()" class="relative p-2 rounded-xl bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border border-emerald-200 transition" title="Toggle Two-Way WhatsApp Assistant">
          <i data-lucide="message-square" class="w-4 h-4"></i>
          <span class="absolute -top-1 -right-1 flex h-3 w-3">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
          </span>
        </button>
      </div>

    </div>
  </header>

  <!-- ================= INCOMING SMS TOAST NOTIFICATION ================= -->
  <div id="sms-toast" class="hidden fixed top-20 right-6 z-50 max-w-sm w-full bg-slate-900 text-white p-4 rounded-2xl shadow-2xl border border-slate-700 space-y-2 animate-bounce">
    <div class="flex items-center justify-between text-xs border-b border-slate-800 pb-2">
      <span class="font-bold text-emerald-400 flex items-center space-x-1">
        <i data-lucide="smartphone" class="w-3.5 h-3.5"></i>
        <span>MESSAGES · NOW</span>
      </span>
      <button onclick="document.getElementById('sms-toast').classList.add('hidden')" class="text-slate-400 hover:text-white font-bold">✕</button>
    </div>
    <p class="text-xs text-slate-200" id="sms-toast-body">Your PolicyNest POSP verification code is 451660.</p>
    <div class="flex justify-end pt-1">
      <button onclick="autoFillOTPFromSMS()" class="text-[11px] font-bold text-brand-400 hover:underline">Auto-Fill OTP</button>
    </div>
  </div>

  <!-- ================= SUB-TICKER ================= -->
  <div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 text-white py-2 px-4 border-b border-indigo-900/50">
    <div class="max-w-[1440px] mx-auto flex flex-wrap items-center justify-between text-xs gap-2">
      <div class="flex items-center space-x-3">
        <span class="flex items-center space-x-1.5 text-emerald-400 font-bold">
          <i data-lucide="zap" class="w-3.5 h-3.5"></i>
          <span>Full-Stack AI Engine (Random Forest + OpenCV + SQLite)</span>
        </span>
        <span class="text-slate-500 hidden sm:inline">|</span>
        <span class="text-slate-300 hidden sm:inline">Queue Wait: <strong class="text-white font-mono">1.2 Seconds</strong> (Down from 17.3 Hours)</span>
      </div>
      <div class="flex items-center space-x-4 text-slate-300">
        <span>Trained Accuracy: <strong class="text-emerald-400 font-mono" id="ticker-accuracy">97.5%</strong></span>
        <span>Ops Savings: <strong class="text-emerald-400 font-mono">₹11.9 Lakhs (>80%)</strong></span>
        <span>Database Records: <strong class="text-emerald-400 font-mono">600 Verified</strong></span>
      </div>
    </div>
  </div>

  <!-- ================= MAIN CONTAINER ================= -->
  <div class="max-w-[1440px] w-full mx-auto p-4 sm:p-6 lg:p-8 flex-1">
    
    <!-- ========================================================================= -->
    <!-- VIEW 1: CANDIDATE ONBOARDING WIZARD                                       -->
    <!-- ========================================================================= -->
    <div id="view-applicant" class="space-y-6">
      
      <!-- 2 Columns: Sticky Progress Rail + Form Workspace -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- STICKY LEFT PROGRESS SIDEBAR -->
        <aside class="lg:col-span-4 xl:col-span-3.5 space-y-5 lg:sticky lg:top-24">
          
          <!-- Progress Card -->
          <div class="glass-surface rounded-2xl p-5 border border-slate-200 shadow-sm space-y-4">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Onboarding Progress</p>
                <h3 class="text-xl font-extrabold text-slate-900 mt-0.5" id="sidebar-progress-label">Step 0 of 5: Eligibility</h3>
              </div>
              <div class="relative w-14 h-14 flex items-center justify-center">
                <svg class="w-full h-full transform -rotate-90" viewBox="0 0 36 36">
                  <path class="text-slate-200" stroke-width="3.5" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                  <path id="progress-circle-fill" class="text-brand-600 transition-all duration-700 ease-out" stroke-dasharray="10, 100" stroke-width="3.5" stroke-linecap="round" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                </svg>
                <span id="sidebar-progress-pct" class="absolute text-xs font-black text-slate-900">10%</span>
              </div>
            </div>

            <!-- Milestone Checklist -->
            <div class="space-y-2 pt-2 border-t border-slate-200/80 text-xs">
              <div id="check-item-0" class="flex items-center justify-between p-2 rounded-lg bg-indigo-50/80 border border-indigo-200 text-indigo-900 font-semibold">
                <div class="flex items-center space-x-2">
                  <i data-lucide="shield-alert" class="w-4 h-4 text-brand-600"></i>
                  <span>0. Pre-Screen Eligibility</span>
                </div>
                <span class="text-[10px] bg-brand-100 text-brand-800 px-2 py-0.5 rounded font-mono font-bold">IN PROGRESS</span>
              </div>

              <div id="check-item-1" class="flex items-center justify-between p-2 rounded-lg bg-slate-50 text-slate-500 font-medium">
                <div class="flex items-center space-x-2">
                  <i data-lucide="file-check-2" class="w-4 h-4 text-slate-400"></i>
                  <span>1. DigiLocker / ID KYC</span>
                </div>
                <span class="text-[10px] text-slate-400 font-mono">PENDING</span>
              </div>

              <div id="check-item-2" class="flex items-center justify-between p-2 rounded-lg bg-slate-50 text-slate-500 font-medium">
                <div class="flex items-center space-x-2">
                  <i data-lucide="landmark" class="w-4 h-4 text-slate-400"></i>
                  <span>2. Bank Penny-Drop Payout</span>
                </div>
                <span class="text-[10px] text-slate-400 font-mono">PENDING</span>
              </div>

              <div id="check-item-3" class="flex items-center justify-between p-2 rounded-lg bg-slate-50 text-slate-500 font-medium">
                <div class="flex items-center space-x-2">
                  <i data-lucide="user-check" class="w-4 h-4 text-slate-400"></i>
                  <span>3. Biometric Liveness & e-Sign</span>
                </div>
                <span class="text-[10px] text-slate-400 font-mono">PENDING</span>
              </div>

              <div id="check-item-4" class="flex items-center justify-between p-2 rounded-lg bg-slate-50 text-slate-500 font-medium">
                <div class="flex items-center space-x-2">
                  <i data-lucide="award" class="w-4 h-4 text-slate-400"></i>
                  <span>4. Provisional POSP Agent Code</span>
                </div>
                <span class="text-[10px] text-slate-400 font-mono">PENDING</span>
              </div>

              <div id="check-item-5" class="flex items-center justify-between p-2 rounded-lg bg-slate-50 text-slate-500 font-medium">
                <div class="flex items-center space-x-2">
                  <i data-lucide="graduation-cap" class="w-4 h-4 text-slate-400"></i>
                  <span>5. 15-Hour LMS Regulatory Exam</span>
                </div>
                <span class="text-[10px] text-slate-400 font-mono">PENDING</span>
              </div>
            </div>

            <div class="pt-3 border-t border-slate-200/80 flex items-center justify-between text-xs">
              <span class="text-slate-500">Live Elapsed Stopwatch:</span>
              <span class="font-mono font-bold text-slate-900 bg-slate-100 px-2.5 py-0.5 rounded border border-slate-200" id="live-sla-timer">00:24s</span>
            </div>
          </div>

          <!-- Active Candidate Summary Badge -->
          <div class="glass-surface rounded-2xl p-5 border border-slate-200 shadow-sm space-y-2.5">
            <h4 class="text-xs font-bold text-slate-900 flex items-center space-x-1.5">
              <i data-lucide="user" class="w-3.5 h-3.5 text-brand-600"></i>
              <span>Active Applicant Record</span>
            </h4>
            <div class="text-xs font-mono bg-slate-50 p-2.5 rounded-xl border border-slate-200 space-y-1">
              <p>Name: <strong class="text-slate-900" id="sb-disp-name">--</strong></p>
              <p>PAN: <strong class="text-slate-900" id="sb-disp-pan">--</strong></p>
              <p>Mobile: <strong class="text-slate-900" id="sb-disp-mobile">--</strong></p>
              <p>Application ID: <strong class="text-brand-700" id="sb-disp-appid">APP-2026-LIVE</strong></p>
            </div>
          </div>

          <!-- Trust Badge -->
          <div class="p-4 rounded-2xl bg-gradient-to-br from-slate-900 to-indigo-950 text-white text-xs space-y-2 shadow-md">
            <div class="flex items-center space-x-2">
              <i data-lucide="lock" class="w-4 h-4 text-emerald-400"></i>
              <span class="font-bold text-slate-200">IRDAI Certified Enterprise Core</span>
            </div>
            <p class="text-[11px] text-slate-300 leading-relaxed">
              Real-time SHA-256 cryptographic audit logs recorded in SQLite database. Zero cloud data leaks.
            </p>
          </div>

        </aside>

        <!-- ================= MAIN WORKSPACE ================= -->
        <main class="lg:col-span-8 xl:col-span-8.5 space-y-6">

          <!-- STEP 0: ELIGIBILITY PRE-SCREEN -->
          <section id="step-content-0" class="glass-surface rounded-2xl p-6 sm:p-8 space-y-6 shadow-sm border border-slate-200">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200/80 pb-4">
              <div>
                <div class="inline-flex items-center space-x-1.5 px-2.5 py-0.5 rounded-full bg-indigo-50 text-brand-700 text-xs font-bold border border-indigo-200 mb-2">
                  <i data-lucide="shield" class="w-3.5 h-3.5"></i>
                  <span>Stage 0 · Regulatory Pre-Screening</span>
                </div>
                <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">Basic Regulatory Eligibility</h2>
                <p class="text-xs text-slate-500 mt-1">
                  We check IRDAI age compliance, PAN category, and broker exclusivity instantly before asking for any document uploads.
                </p>
              </div>
              <span class="self-start text-xs font-mono font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 px-2.5 py-1 rounded-md">
                Pre-Screens 55.4% Rejections
              </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              
              <!-- Full Name -->
              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                  Full Legal Name (as per PAN Card)
                </label>
                <div class="relative">
                  <input type="text" id="input-name" placeholder="Enter your full name" oninput="syncCandidateName(this.value)" class="w-full bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-brand-500 transition shadow-sm">
                  <div class="absolute right-3 top-2.5 text-slate-400">
                    <i data-lucide="user" class="w-4 h-4"></i>
                  </div>
                </div>
                <p class="text-[11px] text-slate-500 mt-1">Rulebook §5 handles maiden names, initials & swapped order automatically.</p>
              </div>

              <!-- Mobile -->
              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                  WhatsApp Mobile Number
                </label>
                <div class="flex space-x-2">
                  <div class="relative flex-1">
                    <span class="absolute left-3 top-2.5 text-xs font-bold text-slate-500">+91</span>
                    <input type="tel" id="input-mobile" maxlength="10" placeholder="10-digit number" oninput="syncCandidateMobile(this.value)" class="w-full font-mono bg-white border border-slate-300 rounded-xl pl-12 pr-4 py-2.5 text-sm font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-brand-500 transition shadow-sm">
                  </div>
                  <button type="button" onclick="sendRealOTP()" id="btn-otp" class="px-3.5 py-2 bg-indigo-50 hover:bg-indigo-100 text-brand-700 text-xs font-bold rounded-xl border border-indigo-200 transition flex items-center space-x-1 flex-shrink-0">
                    <i data-lucide="send" class="w-3.5 h-3.5"></i>
                    <span>Send OTP</span>
                  </button>
                </div>
                <p id="otp-status-text" class="text-[11px] text-slate-500 mt-1">We'll send a 6-digit verification code to this number.</p>
              </div>

              <!-- Date of Birth -->
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider">Date of Birth</label>
                  <span id="age-badge" class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-600">Select Date</span>
                </div>
                <input type="date" id="input-dob" onchange="calculateLiveAge(this.value)" class="w-full bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-brand-500 transition shadow-sm">
                <p id="age-feedback" class="text-[11px] text-slate-500 mt-1">Applicant must be at least 18.0 years old (IRDAI Rule 1.1).</p>
              </div>

              <!-- PAN -->
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider">PAN Card Number</label>
                  <span id="pan-badge" class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-600">Enter 10-Digits</span>
                </div>
                <div class="relative">
                  <input type="text" id="input-pan" maxlength="10" placeholder="AAAAA9999A" oninput="validateLivePan(this.value)" class="w-full uppercase font-mono tracking-wider bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-sm font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-brand-500 transition shadow-sm">
                  <div class="absolute right-3 top-2.5">
                    <i id="pan-icon" data-lucide="credit-card" class="w-4 h-4 text-slate-400"></i>
                  </div>
                </div>
                <p id="pan-feedback" class="text-[11px] text-slate-500 mt-1">4th letter must be 'P' for Individual / Natural Person.</p>
              </div>

            </div>

            <!-- IRDAI Exclusivity Sweep -->
            <div class="bg-indigo-50/70 border border-indigo-200/80 rounded-xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div class="flex items-center space-x-3">
                <div class="w-9 h-9 rounded-lg bg-indigo-600 text-white flex items-center justify-center font-bold flex-shrink-0 shadow-sm">
                  <i data-lucide="database" class="w-4 h-4"></i>
                </div>
                <div>
                  <p class="text-xs font-bold text-slate-900">IRDAI Central Broker Exclusivity Sweep</p>
                  <p class="text-[11px] text-slate-500">Real-time check against Insurance Information Bureau (IIB) repository</p>
                </div>
              </div>
              <div class="flex items-center space-x-3">
                <span class="text-xs font-bold text-emerald-600 flex items-center space-x-1">
                  <i data-lucide="check" class="w-3.5 h-3.5"></i>
                  <span>No Conflicting POSP License</span>
                </span>
                <label class="text-[11px] text-slate-500 cursor-pointer flex items-center space-x-1 bg-white px-2.5 py-1 rounded-lg border border-slate-200">
                  <input type="checkbox" id="check-irdai-hit" class="rounded text-brand-600">
                  <span>Simulate Conflict</span>
                </label>
              </div>
            </div>

            <div class="flex justify-between items-center pt-3 border-t border-slate-200/80">
              <span class="text-xs text-slate-500">Zero documents requested until eligibility is certified.</span>
              <button type="button" onclick="executeStep0Check()" class="px-6 py-3 bg-gradient-to-r from-brand-600 to-indigo-600 hover:from-brand-700 hover:to-indigo-700 text-white font-bold rounded-xl shadow-lg shadow-brand-500/20 flex items-center space-x-2 transition transform active:scale-95 text-xs sm:text-sm">
                <span>Certify Eligibility & Continue</span>
                <i data-lucide="arrow-right" class="w-4 h-4"></i>
              </button>
            </div>
          </section>

          <!-- STEP 1: IDENTITY & OPENCV SCANNER -->
          <section id="step-content-1" class="hidden glass-surface rounded-2xl p-6 sm:p-8 space-y-6 shadow-sm border border-slate-200">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200/80 pb-4">
              <div>
                <div class="inline-flex items-center space-x-1.5 px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold border border-emerald-200 mb-2">
                  <i data-lucide="zap" class="w-3.5 h-3.5"></i>
                  <span>Stage 1 · Frictionless Identity Verification</span>
                </div>
                <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">Identity & Educational Proof</h2>
                <p class="text-xs text-slate-500 mt-1">
                  Connect via DigiLocker (recommended by IRDAI) or upload photos with real-time OpenCV image quality verification.
                </p>
              </div>
              <button onclick="goToStep(0)" class="text-xs text-slate-500 hover:text-slate-800 font-bold flex items-center space-x-1 self-start">
                <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
                <span>Back</span>
              </button>
            </div>

            <!-- DigiLocker 1-Click Pull -->
            <div class="border-2 border-emerald-400 bg-gradient-to-br from-emerald-50/50 via-white to-emerald-50/30 rounded-2xl p-5 relative overflow-hidden shadow-sm">
              <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div class="flex items-start space-x-4">
                  <div class="w-12 h-12 rounded-xl bg-emerald-600 text-white flex items-center justify-center shadow-md shadow-emerald-500/20 flex-shrink-0">
                    <i data-lucide="fingerprint" class="w-6 h-6"></i>
                  </div>
                  <div>
                    <div class="flex items-center space-x-2">
                      <h3 class="text-base font-extrabold text-slate-900">1-Click DigiLocker Instant Pull</h3>
                      <span class="text-[10px] font-black uppercase tracking-wider bg-emerald-500 text-white px-2 py-0.5 rounded-full">Recommended · 30s Pass</span>
                    </div>
                    <p class="text-xs text-slate-600 mt-1 max-w-xl">
                      Fetches cryptographic, tamper-proof e-Aadhaar, PAN, and 10th CBSE Marksheet directly from Government servers. Bypasses 100% of human review delays.
                    </p>
                  </div>
                </div>
                <button type="button" onclick="openDigiLockerModal()" id="btn-digilocker-trigger" class="px-5 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl shadow-md shadow-emerald-600/25 flex items-center justify-center space-x-2 transition text-xs sm:text-sm flex-shrink-0">
                  <i data-lucide="lock" class="w-4 h-4"></i>
                  <span>Launch DigiLocker Consent</span>
                </button>
              </div>

              <div id="digilocker-hud" class="hidden mt-4 pt-4 border-t border-emerald-200/80 grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div class="bg-white p-3 rounded-xl border border-emerald-200 text-xs">
                  <div class="flex items-center space-x-1.5 text-emerald-700 font-bold mb-1">
                    <i data-lucide="check-circle-2" class="w-4 h-4"></i>
                    <span>Aadhaar (UIDAI XML)</span>
                  </div>
                  <p class="text-slate-700 font-semibold" id="dl-disp-aadhaar-name">--</p>
                  <p class="text-[10px] text-slate-500 font-mono" id="dl-disp-aadhaar-num">UID: XXXXXXXX9744 · Verified</p>
                </div>
                <div class="bg-white p-3 rounded-xl border border-emerald-200 text-xs">
                  <div class="flex items-center space-x-1.5 text-emerald-700 font-bold mb-1">
                    <i data-lucide="check-circle-2" class="w-4 h-4"></i>
                    <span>PAN (Income Tax)</span>
                  </div>
                  <p class="text-slate-700 font-semibold font-mono" id="dl-disp-pan-num">--</p>
                  <p class="text-[10px] text-slate-500">Status: Active & Linked</p>
                </div>
                <div class="bg-white p-3 rounded-xl border border-emerald-200 text-xs">
                  <div class="flex items-center space-x-1.5 text-emerald-700 font-bold mb-1">
                    <i data-lucide="check-circle-2" class="w-4 h-4"></i>
                    <span>10th Marksheet (CBSE)</span>
                  </div>
                  <p class="text-slate-700 font-semibold">Result: PASS</p>
                  <p class="text-[10px] text-slate-500">Board: CBSE Central (Qualified)</p>
                </div>
              </div>
            </div>

            <!-- Real File Upload Grid with Real OpenCV Analysis & Image Previews -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              
              <!-- PAN Card -->
              <div class="bg-white border border-slate-200 rounded-xl p-4 relative hover:border-brand-400 transition group space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold text-slate-800 flex items-center space-x-1.5">
                    <i data-lucide="credit-card" class="w-4 h-4 text-brand-600"></i>
                    <span>PAN Card Front</span>
                  </span>
                  <span id="badge-doc-pan" class="text-[10px] bg-slate-100 text-slate-600 font-bold px-2 py-0.5 rounded">Ready</span>
                </div>
                <div class="relative h-28 bg-slate-50 border-2 border-dashed border-slate-300 rounded-lg flex flex-col items-center justify-center p-2 text-center overflow-hidden">
                  <img id="preview-pan" class="hidden absolute inset-0 w-full h-full object-cover">
                  <div id="laser-pan" class="hidden laser-scan-anim"></div>
                  <div id="drop-pan-prompt">
                    <i data-lucide="camera" class="w-6 h-6 text-slate-400 mb-1 mx-auto group-hover:text-brand-500 transition"></i>
                    <p class="text-[11px] text-slate-500 font-medium">Upload or Drag image file</p>
                  </div>
                  <input type="file" accept="image/*" onchange="handleRealFileUpload(this, 'pan')" class="absolute inset-0 opacity-0 cursor-pointer">
                </div>
                <div class="text-[10px] text-slate-500 flex items-center justify-between pt-1">
                  <span>OpenCV Var: <strong class="text-emerald-600" id="pan-blur-val">--</strong></span>
                  <button type="button" onclick="loadSampleDoc('pan')" class="text-brand-600 font-bold hover:underline">Use Sample</button>
                </div>
              </div>

              <!-- Aadhaar -->
              <div class="bg-white border border-slate-200 rounded-xl p-4 relative hover:border-brand-400 transition group space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold text-slate-800 flex items-center space-x-1.5">
                    <i data-lucide="file-badge" class="w-4 h-4 text-brand-600"></i>
                    <span>Aadhaar Front & Back</span>
                  </span>
                  <span id="badge-doc-aadhaar" class="text-[10px] bg-slate-100 text-slate-600 font-bold px-2 py-0.5 rounded">Ready</span>
                </div>
                <div class="relative h-28 bg-slate-50 border-2 border-dashed border-slate-300 rounded-lg flex flex-col items-center justify-center p-2 text-center overflow-hidden">
                  <img id="preview-aadhaar" class="hidden absolute inset-0 w-full h-full object-cover">
                  <div id="laser-aadhaar" class="hidden laser-scan-anim"></div>
                  <div id="drop-aadhaar-prompt">
                    <i data-lucide="camera" class="w-6 h-6 text-slate-400 mb-1 mx-auto group-hover:text-brand-500 transition"></i>
                    <p class="text-[11px] text-slate-500 font-medium">Auto-masks first 8 digits</p>
                  </div>
                  <input type="file" accept="image/*" onchange="handleRealFileUpload(this, 'aadhaar')" class="absolute inset-0 opacity-0 cursor-pointer">
                </div>
                <div class="text-[10px] text-slate-500 flex items-center justify-between pt-1">
                  <span>Privacy Masking: <strong class="text-emerald-600">Active</strong></span>
                  <button type="button" onclick="loadSampleDoc('aadhaar')" class="text-brand-600 font-bold hover:underline">Use Sample</button>
                </div>
              </div>

              <!-- Marksheet -->
              <div class="bg-white border border-slate-200 rounded-xl p-4 relative hover:border-brand-400 transition group space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold text-slate-800 flex items-center space-x-1.5">
                    <i data-lucide="graduation-cap" class="w-4 h-4 text-brand-600"></i>
                    <span>Class 10 Marksheet</span>
                  </span>
                  <span id="badge-doc-marksheet" class="text-[10px] bg-slate-100 text-slate-600 font-bold px-2 py-0.5 rounded">Ready</span>
                </div>
                <div class="relative h-28 bg-slate-50 border-2 border-dashed border-slate-300 rounded-lg flex flex-col items-center justify-center p-2 text-center overflow-hidden">
                  <img id="preview-marksheet" class="hidden absolute inset-0 w-full h-full object-cover">
                  <div id="laser-marksheet" class="hidden laser-scan-anim"></div>
                  <div id="drop-marksheet-prompt">
                    <i data-lucide="upload-cloud" class="w-6 h-6 text-slate-400 mb-1 mx-auto group-hover:text-brand-500 transition"></i>
                    <p class="text-[11px] text-slate-500 font-medium">Must show PASS result</p>
                  </div>
                  <input type="file" accept="image/*" onchange="handleRealFileUpload(this, 'marksheet')" class="absolute inset-0 opacity-0 cursor-pointer">
                </div>
                <div class="text-[10px] text-slate-500 flex items-center justify-between pt-1">
                  <span>Rule 3.1: <strong class="text-emerald-600">10th Pass</strong></span>
                  <button type="button" onclick="loadSampleDoc('marksheet')" class="text-brand-600 font-bold hover:underline">Use Sample</button>
                </div>
              </div>

            </div>

            <!-- Real Defect Warning Alert -->
            <div id="cv-warning-banner" class="hidden bg-amber-50 border border-amber-200 rounded-xl p-4 flex items-start space-x-3">
              <i data-lucide="alert-triangle" class="w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5"></i>
              <div class="text-xs">
                <p class="font-bold text-amber-900" id="cv-warning-title">Real-time Quality Defect Detected</p>
                <p class="text-amber-700 mt-0.5" id="cv-warning-desc">Image has blurred edges (Laplacian variance < 85.0). Please retake now to avoid an ops review delay.</p>
              </div>
            </div>

            <div class="flex justify-between items-center pt-3 border-t border-slate-200/80">
              <span class="text-xs text-slate-500">Processed by OpenCV Computer Vision Engine.</span>
              <button type="button" onclick="goToStep(2)" class="px-6 py-3 bg-gradient-to-r from-brand-600 to-indigo-600 hover:from-brand-700 hover:to-indigo-700 text-white font-bold rounded-xl shadow-lg shadow-brand-500/20 flex items-center space-x-2 transition transform active:scale-95 text-xs sm:text-sm">
                <span>Continue to Bank & Payout</span>
                <i data-lucide="arrow-right" class="w-4 h-4"></i>
              </button>
            </div>
          </section>

          <!-- STEP 2: BANK & REAL IFSC LOOKUP -->
          <section id="step-content-2" class="hidden glass-surface rounded-2xl p-6 sm:p-8 space-y-6 shadow-sm border border-slate-200">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200/80 pb-4">
              <div>
                <div class="inline-flex items-center space-x-1.5 px-2.5 py-0.5 rounded-full bg-indigo-50 text-brand-700 text-xs font-bold border border-indigo-200 mb-2">
                  <i data-lucide="landmark" class="w-3.5 h-3.5"></i>
                  <span>Stage 2 · Commission Payout Setup</span>
                </div>
                <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">Bank Mandate & NPCI Penny Drop</h2>
                <p class="text-xs text-slate-500 mt-1">
                  We verify your bank account via NPCI IMPS to ensure instant monthly commission settlements.
                </p>
              </div>
              <button onclick="goToStep(1)" class="text-xs text-slate-500 hover:text-slate-800 font-bold flex items-center space-x-1 self-start">
                <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
                <span>Back</span>
              </button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Bank Account Number</label>
                <input type="password" id="input-acc" placeholder="e.g. 50100234918231" class="w-full font-mono bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-brand-500 transition shadow-sm">
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Confirm Bank Account Number</label>
                <input type="text" id="input-acc-confirm" placeholder="Confirm account number" class="w-full font-mono bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-brand-500 transition shadow-sm">
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Bank IFSC Code</label>
                <div class="relative">
                  <input type="text" id="input-ifsc" maxlength="11" placeholder="e.g. HDFC0000060" oninput="lookupBankIFSC(this.value)" class="w-full uppercase font-mono bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-sm font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-brand-500 transition shadow-sm">
                  <span id="ifsc-branch-badge" class="hidden absolute right-3 top-2 text-xs font-bold text-brand-600 bg-brand-50 px-2 py-0.5 rounded">--</span>
                </div>
                <p id="ifsc-desc" class="text-[11px] text-slate-500 mt-1">Type IFSC code to verify authorized bank branch.</p>
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Cancelled Cheque / Passbook</label>
                <div class="bg-slate-50 border border-slate-300 rounded-xl px-4 py-2.5 text-xs text-slate-600 flex items-center justify-between">
                  <span class="font-mono truncate" id="cheque-filename">cheque_verified.pdf</span>
                  <span class="text-emerald-600 font-bold flex-shrink-0">OCR: 96% Match</span>
                </div>
              </div>
            </div>

            <!-- Penny Drop Card -->
            <div class="bg-gradient-to-r from-slate-900 to-indigo-950 text-white rounded-2xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-lg border border-indigo-900/60">
              <div class="flex items-center space-x-3.5">
                <div class="w-11 h-11 rounded-xl bg-white/10 flex items-center justify-center text-emerald-400 flex-shrink-0">
                  <i data-lucide="coins" class="w-6 h-6"></i>
                </div>
                <div>
                  <h4 class="text-sm font-extrabold text-white">Execute NPCI ₹1 Penny Drop Verification</h4>
                  <p class="text-xs text-slate-300 mt-0.5" id="penny-drop-status">Instant IMPS verification of beneficiary name</p>
                </div>
              </div>
              <button type="button" onclick="executePennyDrop()" id="btn-penny" class="px-5 py-2.5 bg-emerald-500 hover:bg-emerald-600 text-white font-bold rounded-xl text-xs flex items-center justify-center space-x-2 transition shadow-md shadow-emerald-500/25 flex-shrink-0">
                <i data-lucide="check-circle" class="w-4 h-4"></i>
                <span>Deposit ₹1 & Match Name</span>
              </button>
            </div>

            <div id="penny-result-box" class="hidden bg-emerald-50 border border-emerald-200 rounded-xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div class="flex items-center space-x-3">
                <div class="w-8 h-8 rounded-full bg-emerald-500 text-white flex items-center justify-center font-bold flex-shrink-0">✓</div>
                <div>
                  <p class="text-xs font-bold text-emerald-950">NPCI Beneficiary Confirmed: <span class="font-mono" id="penny-returned-name">--</span></p>
                  <p class="text-[11px] text-emerald-700">Name Match Score: 99.4% · Rulebook §5.1 Exact Match · Zero Commission Risk</p>
                </div>
              </div>
              <span class="text-xs font-mono font-bold text-emerald-800 bg-emerald-100 px-3 py-1 rounded-full self-start sm:self-center" id="penny-ref-badge">
                Ref: NPCI-SETTLED
              </span>
            </div>

            <div class="flex justify-between items-center pt-3 border-t border-slate-200/80">
              <span class="text-xs text-slate-500">Eliminates Section 42D commission escrow delays.</span>
              <button type="button" onclick="goToStep(3)" class="px-6 py-3 bg-gradient-to-r from-brand-600 to-indigo-600 hover:from-brand-700 hover:to-indigo-700 text-white font-bold rounded-xl shadow-lg shadow-brand-500/20 flex items-center space-x-2 transition transform active:scale-95 text-xs sm:text-sm">
                <span>Continue to Biometric Liveness</span>
                <i data-lucide="arrow-right" class="w-4 h-4"></i>
              </button>
            </div>
          </section>

          <!-- STEP 3: REAL BIOMETRIC LIVENESS & E-SIGN -->
          <section id="step-content-3" class="hidden glass-surface rounded-2xl p-6 sm:p-8 space-y-6 shadow-sm border border-slate-200">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200/80 pb-4">
              <div>
                <div class="inline-flex items-center space-x-1.5 px-2.5 py-0.5 rounded-full bg-indigo-50 text-brand-700 text-xs font-bold border border-indigo-200 mb-2">
                  <i data-lucide="scan-face" class="w-3.5 h-3.5"></i>
                  <span>Stage 3 · Anti-Fraud Biometrics & Agreement</span>
                </div>
                <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">Biometric Liveness & e-Sign Agreement</h2>
                <p class="text-xs text-slate-500 mt-1">
                  Passive 3-point biometric liveness check, followed by Aadhaar e-Sign of the IRDAI POSP Appointment Agreement.
                </p>
              </div>
              <button onclick="goToStep(2)" class="text-xs text-slate-500 hover:text-slate-800 font-bold flex items-center space-x-1 self-start">
                <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
                <span>Back</span>
              </button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-center">
              
              <!-- Camera Liveness Viewfinder -->
              <div class="bg-slate-900 rounded-2xl p-5 text-white text-center space-y-4 border border-slate-800 relative overflow-hidden">
                <div class="relative w-44 h-44 mx-auto rounded-full border-4 border-dashed border-emerald-400 flex items-center justify-center overflow-hidden bg-slate-950">
                  <video id="webcam-stream" autoplay playsinline muted class="hidden w-full h-full object-cover"></video>
                  <img id="selfie-frozen-img" class="hidden absolute inset-0 w-full h-full object-cover">
                  <div id="liveness-radar" class="laser-scan-anim"></div>
                  <i id="webcam-placeholder-icon" data-lucide="user" class="w-24 h-24 text-slate-600"></i>
                  <div class="absolute bottom-2 text-[10px] font-mono bg-black/60 px-2 py-0.5 rounded text-emerald-400">
                    LIVE FEED ACTIVE
                  </div>
                </div>

                <div class="space-y-1">
                  <p class="text-xs font-bold text-slate-200">3-Point Passive Liveness Detection</p>
                  <p class="text-[11px] text-slate-400">Position face inside oval and blink naturally</p>
                </div>

                <div class="grid grid-cols-3 gap-2 text-[10px] font-mono pt-2 border-t border-slate-800">
                  <div class="bg-slate-800 p-1.5 rounded text-emerald-400" id="live-check-center">✓ Centered</div>
                  <div class="bg-slate-800 p-1.5 rounded text-emerald-400" id="live-check-blink">✓ Blink OK</div>
                  <div class="bg-slate-800 p-1.5 rounded text-emerald-400" id="live-check-anti">✓ Score 0.98</div>
                </div>

                <div class="flex space-x-2">
                  <button type="button" onclick="startRealWebcam()" class="flex-1 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold rounded-xl text-xs flex items-center justify-center space-x-1 transition">
                    <i data-lucide="video" class="w-3.5 h-3.5"></i>
                    <span>Real Camera</span>
                  </button>
                  <button type="button" onclick="captureWebcamSnapshot()" id="btn-capture-selfie" class="flex-1 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl text-xs flex items-center justify-center space-x-1 transition">
                    <i data-lucide="camera" class="w-3.5 h-3.5"></i>
                    <span>Capture Selfie</span>
                  </button>
                </div>
              </div>

              <!-- Form 1-A Agreement -->
              <div class="bg-slate-50 border border-slate-200 rounded-2xl p-5 space-y-3.5">
                <div class="flex items-center justify-between">
                  <h4 class="text-xs font-bold text-slate-900 flex items-center space-x-1.5">
                    <i data-lucide="file-signature" class="w-4 h-4 text-brand-600"></i>
                    <span>IRDAI Form 1-A POSP Agreement</span>
                  </h4>
                  <span class="text-[10px] bg-indigo-100 text-indigo-800 font-bold px-2 py-0.5 rounded">SignDesk e-Sign</span>
                </div>

                <div class="bg-white p-3 rounded-xl border border-slate-200 text-[11px] text-slate-600 font-mono h-32 overflow-y-auto space-y-1">
                  <p class="font-bold text-slate-800">POLICYNEST BROKERAGE APPOINTMENT AGREEMENT</p>
                  <p>1. The POSP agrees to adhere to the IRDAI Guidelines 2026.</p>
                  <p>2. Mandatory completion of 15 hours training and passing the certification exam.</p>
                  <p>3. Payouts subject to Rulebook v3.2 commission schedules.</p>
                  <p>4. No dual POSP agency with any conflicting general or life insurer.</p>
                </div>

                <label class="flex items-start space-x-2.5 text-xs text-slate-700 cursor-pointer pt-1">
                  <input type="checkbox" id="check-esign" checked class="mt-0.5 rounded text-brand-600">
                  <span>I authorize PolicyNest to affix my e-Sign via Aadhaar OTP consent.</span>
                </label>

                <div class="bg-emerald-50 text-emerald-800 text-[11px] p-2 rounded-lg border border-emerald-200 flex items-center space-x-2">
                  <i data-lucide="shield-check" class="w-4 h-4 text-emerald-600 flex-shrink-0"></i>
                  <span>Aadhaar e-Sign will be executed instantly upon submission.</span>
                </div>
              </div>

            </div>

            <!-- Final Submit with SQLite DB Persistence -->
            <div class="flex justify-between items-center pt-3 border-t border-slate-200/80">
              <span class="text-xs text-slate-500">Evaluated by Random Forest Ensemble & SQLite.</span>
              <button type="button" onclick="submitFullApplication()" id="btn-final-submit" class="px-8 py-3.5 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white font-extrabold rounded-xl shadow-xl shadow-emerald-600/30 flex items-center space-x-2 transition transform active:scale-95 text-xs sm:text-sm">
                <i data-lucide="check-circle-2" class="w-4 h-4 sm:w-5 sm:h-5"></i>
                <span>Submit Application for Instant Approval</span>
              </button>
            </div>
          </section>

          <!-- STEP 4: INSTANT APPROVAL & CREDENTIAL -->
