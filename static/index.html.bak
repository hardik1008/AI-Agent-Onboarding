          </div>
          <h2 class="text-2xl font-extrabold tracking-tight">Trained AI Decision Engine (Scikit-Learn + Joblib)</h2>
          <p class="text-xs text-slate-300 mt-1 max-w-xl">
            Trained on 600 multi-document applications and 3,600 document OCR profiles. Features Gini impurity tree splits and zero cloud LLM costs.
          </p>
        </div>

        <button onclick="triggerAIRetraining()" id="btn-retrain-ai" class="px-5 py-3 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white font-extrabold rounded-xl text-xs shadow-lg shadow-emerald-500/20 flex items-center space-x-2 transition self-start sm:self-center">
          <i data-lucide="refresh-cw" class="w-4 h-4"></i>
          <span>Retrain Model on SQLite Data</span>
        </button>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
          <p class="text-xs font-bold text-slate-400 uppercase">Training Accuracy</p>
          <p class="text-2xl font-extrabold text-emerald-600 mt-1 font-mono" id="ai-stat-acc">97.5%</p>
          <p class="text-[11px] text-slate-500 mt-0.5">Random Forest 100 Trees</p>
        </div>
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
          <p class="text-xs font-bold text-slate-400 uppercase">5-Fold CV Mean</p>
          <p class="text-2xl font-extrabold text-brand-600 mt-1 font-mono" id="ai-stat-cv">95.17%</p>
          <p class="text-[11px] text-slate-500 mt-0.5">Stratified Cross-Val</p>
        </div>
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
          <p class="text-xs font-bold text-slate-400 uppercase">Reject Recall</p>
          <p class="text-2xl font-extrabold text-rose-600 mt-1 font-mono" id="ai-stat-recall">100.0%</p>
          <p class="text-[11px] text-slate-500 mt-0.5">Zero Missed Disqualifications</p>
        </div>
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
          <p class="text-xs font-bold text-slate-400 uppercase">Marginal API Cost</p>
          <p class="text-2xl font-extrabold text-teal-600 mt-1 font-mono">₹0.00</p>
          <p class="text-[11px] text-slate-500 mt-0.5">Local In-Memory Inference</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Left: Confusion Matrix -->
        <div class="lg:col-span-6 bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-slate-200 pb-3">
            <h3 class="text-sm font-bold text-slate-900 flex items-center space-x-2">
              <i data-lucide="grid" class="w-4 h-4 text-brand-600"></i>
              <span>Confusion Matrix (Ground Truth vs Model Prediction)</span>
            </h3>
            <span class="text-xs font-mono font-bold text-slate-500">N = 600</span>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-center text-xs border border-slate-200 rounded-xl overflow-hidden">
              <thead class="bg-slate-100 text-slate-700 font-bold">
                <tr>
                  <th class="p-3 text-left">Actual \ Predicted</th>
                  <th class="p-3 bg-emerald-50 text-emerald-800">APPROVE</th>
                  <th class="p-3 bg-amber-50 text-amber-800">NEEDS_INFO</th>
                  <th class="p-3 bg-rose-50 text-rose-800">REJECT</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 font-mono font-bold">
                <tr>
                  <td class="p-3 text-left font-sans text-slate-700 bg-slate-50">Actual APPROVE (364)</td>
                  <td class="p-3 bg-emerald-100/60 text-emerald-950 text-sm">364</td>
                  <td class="p-3 text-slate-400">0</td>
                  <td class="p-3 text-slate-400">0</td>
                </tr>
                <tr>
                  <td class="p-3 text-left font-sans text-slate-700 bg-slate-50">Actual NEEDS_INFO (176)</td>
                  <td class="p-3 text-slate-500">15</td>
                  <td class="p-3 bg-amber-100/60 text-amber-950 text-sm">161</td>
                  <td class="p-3 text-slate-400">0</td>
                </tr>
                <tr>
                  <td class="p-3 text-left font-sans text-slate-700 bg-slate-50">Actual REJECT (60)</td>
                  <td class="p-3 text-slate-400">0</td>
                  <td class="p-3 text-slate-400">0</td>
                  <td class="p-3 bg-rose-100/60 text-rose-950 text-sm">60</td>
                </tr>
              </tbody>
            </table>
          </div>

          <p class="text-[11px] text-slate-500">
            Note: <strong>100% Reject Recall</strong> guarantees that no disqualified applicant (underage, corporate PAN, IIB conflict) slips through.
          </p>
        </div>

        <!-- Right: Feature Importances -->
        <div class="lg:col-span-6 bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-slate-200 pb-3">
            <h3 class="text-sm font-bold text-slate-900 flex items-center space-x-2">
              <i data-lucide="bar-chart-3" class="w-4 h-4 text-brand-600"></i>
              <span>Engineered Feature Importances (Gini Impurity %)</span>
            </h3>
            <span class="text-xs font-mono font-bold text-slate-500">14 Features</span>
          </div>

          <div class="space-y-3" id="ai-feature-bars-container">
            <!-- Populated via API -->
          </div>
        </div>

      </div>

    </div>

  </div>

  <!-- ================= DIGILOCKER MODAL ================= -->
  <div id="digilocker-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 modal-backdrop">
    <div class="bg-white rounded-3xl max-w-lg w-full overflow-hidden shadow-2xl border border-slate-200">
      <div class="bg-[#0b2b4f] p-4 text-white flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-9 h-9 rounded-lg bg-white flex items-center justify-center font-bold text-[#0b2b4f] text-xs shadow">
            DL
          </div>
          <div>
            <p class="text-xs font-extrabold uppercase tracking-wider">DigiLocker · MeriPehchan</p>
            <p class="text-[10px] text-slate-300">National e-Governance Division (NeGD)</p>
          </div>
